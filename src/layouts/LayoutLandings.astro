---
import Layout from "./Layout.astro";
import { ALL_LANDING_DEFINITIONS } from "@jjlmoya/landings";
import { LANDINGS_VERSION } from "@jjlmoya/landings/version";
import { getLandingAlternates } from "../i18n/gamebob";

interface Props {
    landingId: string;
    locale?: "es";
}

const { landingId, locale = "es" } = Astro.props;

const def = ALL_LANDING_DEFINITIONS.find((d) => d.entry.id === landingId);
if (!def) {
    throw new Error(`Landing with ID ${landingId} not found`);
}

const loader = def.entry.i18n[locale] || def.entry.i18n.en;
if (!loader) {
    throw new Error(`Loader not found for locale ${locale}`);
}
const card = await loader();
const seo = {
    title: card.title,
    description: card.description,
    ...def.entry.seo,
    ...card.seo,
};
const cssPath = def.entry.publicAssets?.cssPath;
const versionedCssPath = cssPath ? `${cssPath}${cssPath.includes("?") ? "&" : "?"}version=${LANDINGS_VERSION}` : null;
const alternateUrls = await getLandingAlternates(landingId);
const { default: LandingComponent } = (await def.LandingComponent()) as { default: any };
---

<Layout
    title={`${seo.title}`}
    description={seo.description}
    image={seo.openGraphImage ?? seo.image}
    fullWidth={true}
    mainClass="layout-main-landing"
    showBackground={false}
    alternateUrls={alternateUrls}
>
    {versionedCssPath && <link slot="head" rel="preload" href={versionedCssPath} as="style" />}
    {versionedCssPath && <link slot="head" rel="stylesheet" href={versionedCssPath} />}
    <LandingComponent locale={locale} />
</Layout>
