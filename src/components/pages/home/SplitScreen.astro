---
import HomeLeftSection from './HomeLeftSection.astro';
import HomeRightSection from './HomeRightSection.astro';
import { getSiteNavigation } from "@jjlmoya/identity/navigation";

const homeSections = new Set(["projects", "apps", "utilities", "concepts", "games", "talks"]);
const linksLeft = getSiteNavigation({ language: "es" })
    .filter((item) => homeSections.has(item.section))
    .map(({ label, href }) => ({ label, href }));

const linksRight = [
    { label: "inicio", href: "/gamebob/" },
    { label: "prototipos", href: "/gamebob/prototipos/" },
    { label: "mecánicas", href: "/gamebob/mecanicas/" },
    { label: "roadmap", href: "/gamebob/roadmap/" },
    { label: "post mortem", href: "/gamebob/post-mortem/" },
];
---

<div class="home-container">
    <h1 class="sr-only">jjlmoya - Portfolio & GameBob Studio</h1>
    <HomeLeftSection links={linksLeft} />
    <HomeRightSection links={linksRight} />
</div>

<style>
    .home-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    @media (min-width: 768px) {
        .home-container {
            flex-direction: row;
            min-height: 100vh;
        }
    }
</style>
