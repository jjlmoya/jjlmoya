---
import IdentityFooter from "@jjlmoya/identity/footer";
import packageJson from "../../package.json";

interface Props {
    className?: string;
}

const { className = "" } = Astro.props;
---

<IdentityFooter
    identity="jjlmoya"
    language="es"
    version={packageJson.version}
    class={className}
/>
