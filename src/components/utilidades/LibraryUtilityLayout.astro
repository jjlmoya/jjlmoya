---
import LayoutUtility from "../../layouts/LayoutUtility.astro";
import UtilityHeader from "./UtilityHeader.astro";
import { getUtilityAlternates } from "../../i18n/gamebob";
import type { UtilityItem } from "../../data/utilities/types";
import packageJson from "../../../package.json";

interface Props {
    tool: {
        entry: any;
        Component: any;
        SEOComponent: any;
        BibliographyComponent: any;
    };
    categoryEntry: any;
    category?: string;
    relatedUtilities?: UtilityItem[];
    categoryKey: string;
}

const { tool, categoryEntry, category, relatedUtilities = [], categoryKey } = Astro.props;
const { entry } = tool;

type ComponentLoader = () => Promise<{ default: any }>;
const Component = ((await (tool.Component as ComponentLoader)()) as { default: any }).default;
const SEOComponent = ((await (tool.SEOComponent as ComponentLoader)()) as { default: any }).default;
const BibliographyComponent = ((await (tool.BibliographyComponent as ComponentLoader)()) as { default: any }).default;

const content = await entry.i18n.es!();
const enContent = await entry.i18n.en!();
const words = content.title.split(" ");
const titleHighlight = words[0] ?? "";
const titleBase = words.slice(1).join(" ");

const image = content.slug;

const alternateUrls = categoryKey ? await getUtilityAlternates(tool, categoryEntry) : [];

const getPackageVersion = (key: string): string => {
    const pkgName = `@jjlmoya/utils-${key}`;
    const deps = packageJson.dependencies as Record<string, string>;
    const range = deps[pkgName] || packageJson.version;
    return range.replace(/^[\^~]/, "");
};

const version = getPackageVersion(categoryKey ?? "");
const cssHref = `/styles/lib/${categoryKey}/${enContent.slug}.css?version=${version}`;
---

<LayoutUtility
    title={content.title}
    description={content.description}
    image={`/images/utilities/${image}.webp`}
    faqItems={content.faq}
    howToSteps={content.howTo}
    appSlug={entry.appSlug}
    alternateUrls={alternateUrls}
    toolCss={cssHref}
    {category}
    {relatedUtilities}
>
    <div slot="header">
        <UtilityHeader
            titleHighlight={titleHighlight}
            titleBase={titleBase}
            description={content.description}
        />
    </div>

    <Component ui={content.ui} locale="es" />

    <div slot="seo">
        <SEOComponent locale="es" />
    </div>

    <div slot="bibliography">
        <BibliographyComponent locale="es" />
    </div>
</LayoutUtility>
