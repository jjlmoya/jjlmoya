---
import CardUtility from "./CardUtility.astro";
import "./RelatedUtilities.css";
import type { UtilityItem } from "../../data/utilities/types";

interface Props {
    category: string;
    currentPath: string;
    utilities?: UtilityItem[];
}

const { category, currentPath, utilities = [] } = Astro.props;
const relatedUtilities = utilities.filter(utility => utility.href !== currentPath);
---

{
    relatedUtilities.length > 0 && (
        <section class="related-utilities">
            <h2 class="related-utilities-title">
                Más utilidades de{" "}
                <span class="related-utilities-accent">{category}</span>
            </h2>
            <div class="related-utilities-grid">
                {relatedUtilities.map((u) => (
                    <CardUtility {...u} />
                ))}
            </div>
        </section>
    )
}
