/.well-known/*
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=31536000, immutable

/*
  Cache-Control: public, max-age=604800, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https://www.google.com https://*; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.iconify.design https://script.google.com https://script.googleusercontent.com https://html2canvas.hertzen.com; connect-src 'self' https://api.jjlmoya.es https://script.google.com https://script.googleusercontent.com https://router.project-osrm.org https://nominatim.openstreetmap.org; frame-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests

/utilidades/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'self'; img-src 'self' data: blob: https://www.google.com https://*; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.iconify.design https://script.google.com https://script.googleusercontent.com https://html2canvas.hertzen.com; connect-src 'self' https://api.jjlmoya.es https://script.google.com https://script.googleusercontent.com https://router.project-osrm.org https://nominatim.openstreetmap.org; frame-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
